    certbot certonly \
      --dns-cloudflare \
      --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini \
      --dns-cloudflare-propagation-seconds 15 \
      --non-interactive \
      --agree-tos \
      --register-unsafely-without-email \
      --force-renewal \
      -d "$DOMAIN"
    
    if [ $? -eq 0 ]; then
        echo -e "\n    ${GREEN}✔ Certificate successfully renewed!${NC}"
        sed -i "s|CERT_PATH=.*|CERT_PATH=\"/etc/letsencrypt/live/$DOMAIN/fullchain.pem\"|g" /etc/sky-vpn.conf
