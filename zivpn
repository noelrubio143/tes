const net = require('net');
const server = net.createServer((c) => {
    c.setNoDelay(true); 
    c.once('data', (d) => {
        c.pause();
        const p = d.toString('utf8');
        if (p.includes('Upgrade: websocket') || p.includes('Upgrade: WebSocket')) {
            const hEnd = d.indexOf('\r\n\r\n');
            const early = hEnd !== -1 ? d.slice(hEnd + 4) : Buffer.alloc(0);
            c.write('HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n');
            const ssh = net.connect({ host: '127.0.0.1', port: 22 }, () => {
                ssh.setNoDelay(true);
                if (early.length > 0) ssh.write(early);
                c.pipe(ssh).pipe(c);
                c.resume();
            });
            ssh.on('error', () => c.destroy());
        } else c.end('HTTP/1.1 400 Bad Request\r\n\r\n');
    });
    c.on('error', () => c.destroy());
});
server.listen(8880, '127.0.0.1');
