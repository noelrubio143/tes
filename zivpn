change_domain() {
    clear
    echo ""
    echo -e "    ${CYAN}${BOLD}CHANGE TARGET DOMAIN & RE-ISSUE AUTO-SSL${NC}"
    echo -e "    ${GRAY}Current Domain:${NC} ${YELLOW}$DOMAIN${NC}"
    echo ""
    read -p "    Enter new domain name (e.g. sub.mydomain.com): " NEW_DOMAIN
    
    if [[ ! "$NEW_DOMAIN" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
        echo -e "    ${RED}Invalid domain syntax. Aborting operation.${NC}"
        sleep 2
        return
    fi

    read -p "    Update Cloudflare A Record for $NEW_DOMAIN? (y/N): " update_cf
    if [[ "$update_cf" =~ ^[Yy]$ ]]; then
        echo -e "\n    ${GRAY}Communicating with Cloudflare API...${NC}"
        EXTRACTED_ROOT=$(echo "$NEW_DOMAIN" | awk -F'.' '{print $(NF-1)"."$NF}')
        
        if cf_upsert_dns "$NEW_DOMAIN" "$SERVER_IP" "$EXTRACTED_ROOT" "$CF_TOKEN"; then
            echo -e "    ${GREEN}✔ Cloudflare DNS A record synchronized to ${SERVER_IP}!${NC}"
        else
            echo -e "    ${YELLOW}⚠ Could not automatically resolve Zone ID for $EXTRACTED_ROOT. Ensure DNS points manually.${NC}"
        fi
    fi

    echo -e "\n    ${GRAY}Executing Certbot DNS-01 Verification Challenge...${NC}"
    chmod 600 /etc/letsencrypt/cloudflare.ini
    
    certbot certonly \
      --dns-cloudflare \
      --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini \
      --dns-cloudflare-propagation-seconds 15 \
      --non-interactive \
      --agree-tos \
      --register-unsafely-without-email \
      -d "$NEW_DOMAIN" &>/tmp/certbot_menu.log

    NEW_CERT="/etc/letsencrypt/live/$NEW_DOMAIN/fullchain.pem"
    NEW_KEY="/etc/letsencrypt/live/$NEW_DOMAIN/privkey.pem"

    if [ -f "$NEW_CERT" ] && [ -f "$NEW_KEY" ]; then
        NEW_CERT_PATH="$NEW_CERT"
        NEW_KEY_PATH="$NEW_KEY"
        echo -e "    ${GREEN}✔ Trusted Let's Encrypt TLS Certificate Issued!${NC}"
    else
        echo -e "    ${YELLOW}⚠ Certbot DNS-01 failed. Fallback to Self-Signed SAN Certificate...${NC}"
        SSL_DIR="/etc/sky-vpn/ssl"
        FALLBACK_CERT="$SSL_DIR/fallback.crt"
        FALLBACK_KEY="$SSL_DIR/fallback.key"
        openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
            -keyout "$FALLBACK_KEY" -out "$FALLBACK_CERT" \
            -subj "/C=US/ST=State/L=City/O=SkyVPN/CN=$NEW_DOMAIN" \
            -addext "subjectAltName=DNS:$NEW_DOMAIN,IP:$SERVER_IP" &>/dev/null
        NEW_CERT_PATH="$FALLBACK_CERT"
        NEW_KEY_PATH="$FALLBACK_KEY"
    fi

    cp /etc/nginx/sites-available/proxy.conf /tmp/proxy.conf.bak

    cat << NGINX_CONF > /etc/nginx/sites-available/proxy.conf
server {
    listen 80 default_server;
    listen 443 ssl http2 default_server;
    server_name $NEW_DOMAIN; 
    ssl_certificate $NEW_CERT_PATH;
    ssl_certificate_key $NEW_KEY_PATH;
    ssl_protocols TLSv1.2 TLSv1.3;
    tcp_nodelay on;

    location /ssh-ws { proxy_pass http://127.0.0.1:8880; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; }
    location /vless-path { proxy_pass http://127.0.0.1:10000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; }
    location /vmess-path { proxy_pass http://127.0.0.1:10001; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; }
    location /trojan-path { proxy_pass http://127.0.0.1:10002; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; }
    location / { return 403; }
}
NGINX_CONF

    if nginx -t &>/dev/null; then
        sed -i "s/DOMAIN=.*/DOMAIN=\"$NEW_DOMAIN\"/g" /etc/sky-vpn.conf
        sed -i "s|CERT_PATH=.*|CERT_PATH=\"$NEW_CERT_PATH\"|g" /etc/sky-vpn.conf
        sed -i "s|KEY_PATH=.*|KEY_PATH=\"$NEW_KEY_PATH\"|g" /etc/sky-vpn.conf
        source /etc/sky-vpn.conf
        systemctl restart nginx
        rm -f /tmp/proxy.conf.bak
        echo -e "    ${GREEN}✔ System domain successfully changed to $NEW_DOMAIN!${NC}\n"
    else
        echo -e "    ${RED}✖ Nginx validation failed. Restoring previous configuration.${NC}\n"
        mv /tmp/proxy.conf.bak /etc/nginx/sites-available/proxy.conf
        systemctl restart nginx
    fi
    read -p "    Press [Enter] to return..."
}

