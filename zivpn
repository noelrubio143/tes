cleanup_terminal() {
    setterm -cursor on 2>/dev/null
    echo -e "${NC}"
}
trap cleanup_terminal EXIT INT TERM

spin_pid=""
start_spinner() {
    local msg="$1"
    setterm -cursor off 2>/dev/null
    (
        local delay=0.08
        local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
        while true; do
            local temp=${spinstr#?}
            printf "\r\033[K    ${CYAN}%c${NC}  ${WHITE}%s${NC}" "$spinstr" "$msg"
            spinstr=$temp${spinstr%"$temp"}
            sleep $delay
        done
    ) &
    spin_pid=$!
}

stop_spinner() {
    local status="${1:-0}"
    local msg="$2"
    if [ -n "$spin_pid" ]; then
        kill "$spin_pid" &>/dev/null
        wait "$spin_pid" 2>/dev/null
    fi
    setterm -cursor on 2>/dev/null
    if [ "$status" -eq 0 ]; then
        printf "\r\033[K    ${GREEN}✔${NC}  ${WHITE}%s${NC}\n" "$msg"
    else
        printf "\r\033[K    ${RED}✖${NC}  ${WHITE}%s${NC}\n" "$msg"
    fi
}

error_exit() {
    stop_spinner 1 "Task Aborted: $1"
    echo ""
    echo -e "    ${RED}${BOLD}CRITICAL DEPLOYMENT FAILURE${NC}"
    echo -e "    ${WHITE}$1${NC}\n"
    exit 1
}

run_with_progress() {
    local cmd="$1"
    local label="$2"
    local est_time="${3:-12}"
    
    setterm -cursor off 2>/dev/null
    eval "$cmd" > /tmp/sky_build.log 2>&1 &
    local pid=$!
    
    local count=0
    local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    
    while kill -0 "$pid" 2>/dev/null; do
        local spin_idx=$((count % 10))
        local spin_char="${spinstr:$spin_idx:1}"
        
        local percent=$(( (count * 100) / (est_time * 10) ))
        if [ "$percent" -gt 95 ]; then percent=95; fi
        if [ "$percent" -lt 5 ]; then percent=5; fi
        
        printf "\r\033[K    ${CYAN}%s${NC}  ${PURPLE}[${CYAN}%3d%%${PURPLE}]${NC}  ${WHITE}%s${NC}" \
               "$spin_char" "$percent" "$label"
               
        sleep 0.1
        ((count++))
    done
    
    wait "$pid"
    local exit_code=$?
    
    setterm -cursor on 2>/dev/null
    
    if [ "$exit_code" -eq 0 ]; then
        printf "\r\033[K    ${GREEN}✔${NC}  ${PURPLE}[${GREEN}100%%${PURPLE}]${NC}  ${WHITE}%s${NC}\n" "$label"
    else
        printf "\r\033[K    ${RED}✖${NC}  ${PURPLE}[${RED}FAIL${PURPLE}]${NC}  ${WHITE}%s${NC}\n" "$label"
        echo -e "\n    ${RED}${BOLD}Execution Details:${NC}"
        tail -n 5 /tmp/sky_build.log | sed 's/^/    /g'
        error_exit "Failed step: $label"
    fi
}

# Cloudflare Smart DNS Creation/Update Function
cf_upsert_dns() {
    local sub_domain="$1"
    local target_ip="$2"
    local base_domain="$3"
    local api_token="$4"

    local zone_id
    zone_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${base_domain}" \
      -H "Authorization: Bearer ${api_token}" \
      -H "Content-Type: application/json" | jq -r '.result[0].id // empty')

    if [ -z "$zone_id" ] || [ "$zone_id" == "null" ]; then
        return 1
    fi

    local record_id
    record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?name=${sub_domain}&type=A" \
      -H "Authorization: Bearer ${api_token}" \
      -H "Content-Type: application/json" | jq -r '.result[0].id // empty')

    if [ -n "$record_id" ] && [ "$record_id" != "null" ]; then
        curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records/${record_id}" \
          -H "Authorization: Bearer ${api_token}" \
          -H "Content-Type: application/json" \
          --data '{"type":"A","name":"'${sub_domain}'","content":"'${target_ip}'","ttl":120,"proxied":false}' > /dev/null
    else
        curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records" \
          -H "Authorization: Bearer ${api_token}" \
          -H "Content-Type: application/json" \
          --data '{"type":"A","name":"'${sub_domain}'","content":"'${target_ip}'","ttl":120,"proxied":false}' > /dev/null
    fi
    return 0
}

